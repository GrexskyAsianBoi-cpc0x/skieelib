function Library:CreateTab(name)
    if not self.Ready then
        local waited = 0
        repeat task.wait(0.1); waited += 0.1 until self.Ready or waited > 12
        if not self.Ready then warn("[Skiee0xc0] CreateTab timeout"); return nil end
    end

    local sidebar, content = self.Sidebar, self.Content
    local btnHolder = New("Frame", {
        Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.Grey, BackgroundTransparency = 1,
        LayoutOrder = #self.Tabs + 1, Parent = sidebar, ZIndex = 12,
    }, { Corner(6) })
    local glowBar = New("Frame", { -- left active-tab glow indicator
        Size = UDim2.new(0, 3, 0, 0), Position = UDim2.new(0, -8, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1, BorderSizePixel = 0, Parent = btnHolder, ZIndex = 13,
    }, { Corner(2) })
    local btn = New("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = name,
        Font = Theme.Font, TextSize = 13, TextColor3 = Theme.SubText, AutoButtonColor = false,
        Parent = btnHolder, ZIndex = 12,
    })

    local page = New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0), Visible = false, Parent = content, ZIndex = 11,
    })
    New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }).Parent = page
    New("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14) }).Parent = page

    local tabObj = { Button = btnHolder, Page = page, GlowBar = glowBar }
    local function selectTab()
        for _, t in ipairs(self.Tabs) do
            t.Page.Visible = false
            Tween(t.Button, { BackgroundTransparency = 1 }, 0.15)
            Tween(t.Button:FindFirstChildOfClass("TextButton"), { TextColor3 = Theme.SubText }, 0.15)
            Tween(t.GlowBar, { Size = UDim2.new(0, 3, 0, 0), BackgroundTransparency = 1 }, 0.15)
        end
        page.Visible = true
        Tween(btnHolder, { BackgroundTransparency = 0 }, 0.15)
        Tween(btn, { TextColor3 = Theme.Text }, 0.15)
        Tween(glowBar, { Size = UDim2.new(0, 3, 0, 20), BackgroundTransparency = 0.2 }, 0.2, Enum.EasingStyle.Back)
    end
    btn.MouseButton1Click:Connect(function()
        PlaySound(Sounds.Click, 0.25)
        selectTab()
    end)
    table.insert(self.Tabs, tabObj)
    if not self._firstTabSet then self._firstTabSet = true; selectTab() end

    local Tab = {}

    function Tab:AddToggle(text, default, callback)
        local holder = New("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme.BlackAlt, Parent = page }, { Corner(6) })
        Stroke(Theme.Border, 1, 0.4).Parent = holder
        New("TextLabel", {
            Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = text,
            Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
        })
        local track = New("Frame", { Size = UDim2.fromOffset(38, 18), Position = UDim2.new(1, -46, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Theme.Grey, Parent = holder }, { Corner(9) })
        local knob = New("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Theme.SubText, Parent = track }, { Corner(7) })
        local state = default or false
        local function render()
            if state then
                Tween(track, { BackgroundColor3 = Theme.Accent }, 0.18)
                Tween(knob, { Position = UDim2.fromOffset(22, 2), BackgroundColor3 = Theme.Black }, 0.18)
            else
                Tween(track, { BackgroundColor3 = Theme.Grey }, 0.18)
                Tween(knob, { Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Theme.SubText }, 0.18)
            end
        end
        render()
        New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = holder }).MouseButton1Click:Connect(function()
            state = not state
            PlaySound(Sounds.Click, 0.25)
            render()
            if callback then callback(state) end
        end)
        return { Set = function(v) state = v; render() end, Get = function() return state end }
    end

    function Tab:AddButton(text, callback)
        local b = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme.BlackAlt, Text = text,
            Font = Theme.Font, TextSize = 13, TextColor3 = Theme.Text, AutoButtonColor = false, Parent = page,
        }, { Corner(6) })
        Stroke(Theme.Border, 1, 0.4).Parent = b
        b.MouseEnter:Connect(function() Tween(b, { BackgroundColor3 = Theme.Grey }, 0.15) end)
        b.MouseLeave:Connect(function() Tween(b, { BackgroundColor3 = Theme.BlackAlt }, 0.15) end)
        b.MouseButton1Click:Connect(function()
            PlaySound(Sounds.Click, 0.3)
            if callback then callback() end
        end)
        return b
    end

    function Tab:AddSlider(text, min, max, default, callback)
        local holder = New("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Theme.BlackAlt, Parent = page }, { Corner(6) })
        Stroke(Theme.Border, 1, 0.4).Parent = holder
        local lbl = New("TextLabel", {
            Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(12, 4), BackgroundTransparency = 1,
            Text = text .. ": " .. tostring(default), Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = holder,
        })
        local barBg = New("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.fromOffset(12, 30), BackgroundColor3 = Theme.Grey, Parent = holder }, { Corner(3) })
        local fill = New("Frame", { Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = Theme.Accent, Parent = barBg }, { Corner(3) })
        local dragging = false
        local function update(inputPos)
            local rel = math.clamp((inputPos - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * rel)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            lbl.Text = text .. ": " .. tostring(val)
            if callback then callback(val) end
        end
        barBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; update(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input.Position.X)
            end
        end)
        return holder
    end

    function Tab:AddLabel(text)
        return New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = text, Font = Theme.Font,
            TextSize = 12, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = page,
        })
    end

    return Tab
end

