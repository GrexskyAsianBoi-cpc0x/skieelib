local function PlaySound(id, volume, pitch)
    local ok, snd = pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = volume or 0.4
        s.PlaybackSpeed = pitch or 1
        s.Parent = SoundService
        s:Play()
        game:GetService("Debris"):AddItem(s, 3)
        return s
    end)
    if ok then return snd end
end

-- ===================== UTIL =====================
local function New(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end

local function Corner(r) return New("UICorner", { CornerRadius = UDim.new(0, r or 6) }) end
local function Stroke(color, thickness, transparency)
    return New("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1, Transparency = transparency or 0 })
end
local function Tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local SCRAMBLE_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*<>/\\|[]{}"
local function ScrambleText(label, finalText, duration, steps)
    steps = steps or 14
    local stepTime = duration / steps
    coroutine.wrap(function()
        for i = 1, steps do
            local out = {}
            local revealCount = math.floor((i / steps) * #finalText)
            for c = 1, #finalText do
                if c <= revealCount then
                    out[c] = finalText:sub(c, c)
                else
                    out[c] = finalText:sub(c, c) == " " and " " or SCRAMBLE_CHARS:sub(math.random(1, #SCRAMBLE_CHARS), math.random(1, #SCRAMBLE_CHARS))
                end
            end
            label.Text = table.concat(out)
            task.wait(stepTime)
        end
        label.Text = finalText
    end)()
end

local function TypeText(label, finalText, charTime)
    charTime = charTime or 0.012
    coroutine.wrap(function()
        for i = 1, #finalText do
            label.Text = finalText:sub(1, i)
            task.wait(charTime)
        end
    end)()
end

