local Win = Library.new({})

task.spawn(function()
    local t = 0
    repeat task.wait(0.2); t += 0.2 until Win.Ready or t > 12
    if not Win.Ready then warn("[Skiee0xc0] TIMEOUT - window never built"); return end

    print("[Skiee0xc0] ready, building tabs")

    local EspTab = Win:CreateTab("ESP")
    local espEnabled = false
    local espBoxes = {}

    local function ClearESP()
        for _, box in pairs(espBoxes) do
            if box.Drawing then box.Drawing:Remove() end
            if box.Name then box.Name:Remove() end
        end
        espBoxes = {}
    end

    local function UpdateESP()
        if not espEnabled then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    local box = espBoxes[plr]
                    if not box then
                        local okDraw, drawing = pcall(function()
                            local d = Drawing.new("Square")
                            d.Thickness = 1
                            d.Color = Theme.Accent
                            d.Filled = false
                            d.Visible = false
                            return d
                        end)
                        if not okDraw then return end
                        local nameTag = Drawing.new("Text")
                        nameTag.Size = 14
                        nameTag.Color = Theme.Text
                        nameTag.Outline = true
                        nameTag.Center = true
                        nameTag.Visible = false
                        box = { Drawing = drawing, Name = nameTag }
                        espBoxes[plr] = box
                    end
                    if onScreen then
                        local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                        local scale = 1000 / math.max(dist, 1)
                        local boxW, boxH = 3 * scale, 5 * scale
                        box.Drawing.Size = Vector2.new(boxW, boxH)
                        box.Drawing.Position = Vector2.new(pos.X - boxW / 2, pos.Y - boxH / 2)
                        box.Drawing.Visible = true
                        box.Name.Position = Vector2.new(pos.X, pos.Y - boxH / 2 - 16)
                        box.Name.Text = plr.Name
                        box.Name.Visible = true
                    else
                        box.Drawing.Visible = false
                        box.Name.Visible = false
                    end
                end
            end
        end
        for plr, box in pairs(espBoxes) do
            if not plr.Character or not plr.Parent then
                box.Drawing:Remove(); box.Name:Remove()
                espBoxes[plr] = nil
            end
        end
    end

    RunService.RenderStepped:Connect(UpdateESP)

    EspTab:AddToggle("Enable Player ESP", false, function(state)
        espEnabled = state
